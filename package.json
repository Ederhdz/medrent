{
  "name": "evolved-earth",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/prepare-cms-build.mjs && astro build && node scripts/audit-production-build.mjs",
    "build:live": "CMS_RELEASE_MODE=live node scripts/prepare-cms-build.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:cms-boundary": "node scripts/audit-cms-boundaries.mjs",
    "test:cms-leak": "node scripts/audit-production-build.mjs",
    "test:cms-mutations": "node scripts/test-cms-mutations.mjs",
    "test:cms-smoke": "node scripts/smoke-routes.mjs",
    "test:cms": "node --test tests/cms/*.test.mjs && npm run test:cms-boundary && npm run test:cms-mutations"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^0.4.9",
    "@astrojs/react": "^4.4.2",
    "@astrojs/vercel": "^9.0.2",
    "@glidejs/glide": "^3.7.1",
    "@strapi/blocks-react-renderer": "^1.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.15.9",
    "dayjs": "^1.11.19",
    "glider-js": "^1.7.9",
    "lenis": "^1.3.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "tailwindcss": "^4.1.18"
  }
}
