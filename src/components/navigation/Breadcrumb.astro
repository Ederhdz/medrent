---
const {
  items,
  textColor,
  /** 'dark' = barra negra (PLP/PDP). 'light' = hero claro sin fondo. */
  surface = 'dark',
  /** 'overlay' = nav absolute (comportamiento anterior). 'inline' = flujo normal, útil en hero. */
  navPosition = 'overlay',
  /** false = tipografía label (12px, medium, tracking 0.5px); último ítem suele ser título de artículo. */
  uppercaseAll = true,
  class: className,
} = Astro.props as {
  items: { name: string; href?: string }[];
  textColor?: string;
  surface?: 'dark' | 'light';
  navPosition?: 'overlay' | 'inline';
  uppercaseAll?: boolean;
  class?: string;
};
const listTypography = uppercaseAll
  ? "text-[12px] uppercase leading-4 tracking-[0.08em]"
  : "text-[12px] font-medium leading-4 tracking-[0.5px] normal-case";
const outerBg = surface === 'light' ? 'bg-transparent' : 'bg-[#000]';
const navLayout =
  navPosition === 'inline'
    ? 'relative'
    : 'absolute';
/**
 * Map legacy `text-dark` / CSS dark-theme token to real dark ink.
 * `--color-text-dark` is near-white in this design system — unsafe on light brand bands.
 */
function resolveBreadcrumbTextColor(
  requested: string | undefined,
  surfaceMode: 'dark' | 'light',
): string {
  const fallback = surfaceMode === 'light' ? 'text-[#171D1C]' : 'text-white';
  if (!requested) return fallback;
  if (
    requested === 'text-dark' ||
    requested.includes('text-dark') ||
    requested.includes('--color-text-dark') ||
    requested.includes('--color-text-default')
  ) {
    return 'text-[#171D1C]';
  }
  return requested;
}
const resolvedTextColor = resolveBreadcrumbTextColor(textColor, surface);
const chevronFill =
  resolvedTextColor.includes('white') || resolvedTextColor === 'text-white'
    ? 'white'
    : '#171D1C';
---
<div class={`mx-auto flex w-full max-w-[1280px] flex-col justify-start ${outerBg} relative `}>
  <nav
    class={`mx-auto flex w-full max-w-[1280px] items-center 
    top-0 lg:top-4
    max-lg:pt-3 max-lg:pb-3 max-lg:px-0 
    lg:px-8 lg:py-4 
    ${navLayout} ${className || ""}`}
    aria-label="Breadcrumb"
  >
    <ol 
      class={`
          scrollbar-hide 
          flex 
          touch-pan-x 
          items-center 
          gap-2 
          overflow-x-auto 
          whitespace-nowrap 
          ml-0
          md:ml-0
          custom-ol-padding
          /* Tablet y desktop */
          max-lg:py-3 
          max-lg:px-0
          ${listTypography}
      `}
    >
    <style>
        /* Solo tablet: 768px a 1023px */
        @media (max-width: 1023px) {
            .custom-ol-padding {
                padding: 12px 0 12px 16px !important;
            }
        }
    </style>

      {items.map((item, index) => {
        const isLast = index === items.length - 1;

        return (
          <>
            <li>
              {isLast ? (
                <span
                  class={`${uppercaseAll ? "font-semibold" : "font-medium"} ${resolvedTextColor}`}
                >
                  {item.name}
                </span>
              ) : (
                <a
                  href={item.href}
                  class={`opacity-70 hover:opacity-100 transition cursor-pointer ${resolvedTextColor}`}
                  style="cursor: pointer;"
                >
                  {item.name}
                </a>
              )}
            </li>

            {!isLast && (
              <li class={`${index === items.length - 2 ? '' : 'opacity-70'} shrink-0`} aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M10 7L15 12L10 17L10 7Z" fill={chevronFill}/>
                </svg>
              </li>
            )}
          </>
        );
      })}
    </ol>
  </nav>
</div>

<style>
  /* Ocultar scrollbar pero mantener funcionalidad */
  .scrollbar-hide {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;  /* Chrome, Safari and Opera */
  }
</style>