---
export const prerender = true;

import Layout from "@layouts/Layout.astro";
import BreadcrumbSchema from "@components/seo/BreadcrumbSchema.astro";
import Breadcrumb from "@components/navigation/Breadcrumb.astro";
import PLPLayout from "@components/product/PLPLayout.astro";
import PLPProductsSection from "@components/product/PLPProductsSection.astro";
import SidebarFilters from "@components/product/SidebarFilters.astro";
import { getProducts } from "@server/api/products";
import { getBrands } from "@server/api/brands";
import { getCategories } from "@server/api/categories";
import { getAllSubcategories } from "@server/api/subcategories";
import { getSiteConfig } from "@server/siteConfig";
import { cms } from "@server/cms";
import { toSameOriginMediaUrl } from "@lib/utils.js";
const siteConfig = await getSiteConfig();

let heroPLP: any = {};
try {
    const response = await cms.get("/plp?populate=*");
    const sliderHero = response?.data || {};
    heroPLP = Array.isArray(sliderHero) ? sliderHero[0] || {} : sliderHero;
} catch (error) {
    console.error('Error fetching slider hero:', error);
    heroPLP = {};
}

/* ---------------- QUERY PARAMS ---------------- */

/* ---------------- FETCH DATA ---------------- */

const products = await getProducts();

const brandsData = await getBrands();
const categoriesData = await getCategories();
const subcategoriesData = await getAllSubcategories();

const baseUrl = Astro.site ? new URL(Astro.site).origin : "https://www.medrent.mx";
const canonicalUrl = new URL(Astro.originPathname ?? Astro.url.pathname, Astro.site).toString();
const breadcrumbId = `${canonicalUrl}#breadcrumb`;
const logoUrl = siteConfig?.favicon512x512?.url;
const mediaUrl = (value: any) => {
  let url = "";
  if (typeof value === "string") url = value;
  else if (typeof value?.url === "string") url = value.url;
  else if (typeof value?.data?.attributes?.url === "string") url = value.data.attributes.url;
  else if (typeof value?.data?.url === "string") url = value.data.url;
  return url ? toSameOriginMediaUrl(url) : "";
};
const fallbackHeroImageUrl = "/temp/HeroPLP.png";
const heroImageDesktopObj = heroPLP.heroImageDesktop ?? null;
const heroImageMobileObj = heroPLP.heroImageMobile ?? heroImageDesktopObj;
const heroImageDesktop = mediaUrl(heroImageDesktopObj) || fallbackHeroImageUrl;
const heroImageMobile = mediaUrl(heroImageMobileObj) || heroImageDesktop;
const heroImageUrl = new URL("/og/og-default-medrent.png", baseUrl).toString();
const totalProducts = products.length;
const seoPlpTitle = "MEDRENT";
const seoPlpDescription ="Tecnología médica confiable para diagnóstico, terapia y rehabilitación. MedRent acerca soluciones clínicas de marcas líderes para optimizar la práctica médica y mejorar resultados terapéuticos en todo México.";
---

<Layout
  title="Catálogo de productos | Equipos médicos y consumibles | MedRent"
  description="Explora equipos por especialidad, aplicación y marca. Tecnología médica con soporte, instalación y opciones de financiamiento."
  keywords="catálogo equipo médico; productos médicos; consumibles; MedRent"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroImageDesktop} fetchpriority="high" />
    <BreadcrumbSchema
      items={[
        { name: "Inicio", url: `${baseUrl}/` },
        { name: "Productos", url: `${baseUrl}/productos` },
      ]}
      id={breadcrumbId}
    />
    <script type="application/ld+json" set:html={
      (() => {
        const slice = Array.isArray(products) ? products.slice(0, 12) : [];
        const itemListElement = slice.map((p, index) => {
          const slug = p?.slug;
          const pdpUrl = slug ? `${baseUrl}/productos/${slug}` : canonicalUrl;
          const imageUrl = Array.isArray(p?.gallery) ? p.gallery[0] : undefined;
          return {
            "@type": "ListItem",
            position: index + 1,
            item: {
              "@type": ["MedicalDevice", "Product"],
              "@id": `${pdpUrl}#product`,
              name: p?.name || "Producto",
              url: pdpUrl,
              image: imageUrl ? [imageUrl] : undefined,
            },
          };
        });

        return JSON.stringify({
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "WebPage",
              "@id": `${canonicalUrl}#webpage`,
              url: canonicalUrl,
              name: "Productos | Equipos médicos y consumibles | MedRent",
              description:
                "Explora equipos por especialidad, aplicación y marca. Tecnología médica con soporte, instalación y opciones de financiamiento.",
              isPartOf: { "@id": `${baseUrl}/#website` },
              about: { "@id": `${baseUrl}/#organization` },
              inLanguage: "es-MX",
              breadcrumb: { "@id": breadcrumbId },
              mainEntity: { "@id": `${canonicalUrl}#itemlist` },
              primaryImageOfPage: {
                "@type": "ImageObject",
                url: heroImageUrl,
              },
            },
            {
              "@type": "CollectionPage",
              "@id": `${canonicalUrl}#collection`,
              url: canonicalUrl,
              name: "Productos | Equipos médicos y consumibles | MedRent",
              description:
                "Explora equipos por especialidad, aplicación y marca. Tecnología médica con soporte, instalación y opciones de financiamiento.",
              isPartOf: { "@id": `${baseUrl}/#website` },
              about: { "@id": `${baseUrl}/#organization` },
              inLanguage: "es-MX",
              mainEntity: { "@id": `${canonicalUrl}#itemlist` },
            },
            {
              "@type": "ItemList",
              "@id": `${canonicalUrl}#itemlist`,
              name: "Productos — listado",
              itemListOrder:
                "https://schema.org/ItemListOrderAscending",
              itemListElement,
            },
          ],
        });
      })()
    }></script>
  </Fragment>

  <!-- HERO -->
  <section class="relative w-full h-[140px] overflow-hidden">
    <div class="absolute inset-0 heroproductos">

      <picture>
        <source media="(max-width: 767px)" srcset={heroImageMobile} />
        <img
          src={heroImageDesktop}
          alt="Todos los productos"
          width={heroImageDesktopObj?.width ?? 1920}
          height={heroImageDesktopObj?.height}
          sizes="100vw"
          class="absolute inset-0 w-full h-full object-cover object-top rounded-b-[24px]"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>

      <div class="relative z-10">
        <Breadcrumb
          surface="light"
          textColor="text-white"
          navPosition="inline"
          items={[
            { name: "INICIO", href: "/" },
            { name: "PRODUCTOS" },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- PLP -->
  <PLPLayout seoTitle={seoPlpTitle} seoDescription={seoPlpDescription}  seoText={siteConfig.seoTextPLP}>
    <Fragment slot="filters">
      <div class="mb-6 self-stretch">
        <h1 class="font-lato text-[28px] font-bold leading-[36px] text-[var(--color-primary)]">
          Todos los productos
        </h1>
        <p class="font-lato text-[22px] font-normal leading-[28px] text-[var(--color-primary)]">
          {totalProducts} Equipos disponibles
        </p>
      </div>
      <SidebarFilters
        brands={brandsData}
        categories={categoriesData}
        subcategories={subcategoriesData}
      />
    </Fragment>

    <PLPProductsSection products={products} />
  </PLPLayout>


  <script is:inline define:vars={{ products }}>
    /* Event: view_item_list — only when GTM helper is present (off in DEV) */
    setTimeout(() => {
      if (typeof window.view_item_list === "function") {
        window.view_item_list(products, "Productos");
      }
    }, 2000);
  </script>

</Layout>

